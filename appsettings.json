{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "DatabaseName": "database"
  },
  "BlobStorage": {
    "ContainerName": "images",
    "PublicBlobAccess": true,
    "MaximumImageDimension": 1600,
    "WebpQuality": 82
  },
  "Email": {
    "Provider": "AzureCommunicationServices",
    "PollIntervalSeconds": 5,
    "MaximumDeliveryAttempts": 5,
    "RetryDelaySeconds": 60
  },
  "AllowedHosts": "*"
}
